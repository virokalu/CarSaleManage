<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CarSaleManage</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CarSaleManage.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
</head>
<body class="d-flex flex-column vh-100">
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-primary shadow-sm border-bottom box-shodow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-car-front-fill"></i> CarSaleManage</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    
                    <ul class="navbar-nav ms-auto align-items-center gap-2">
                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                        {
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center px-3 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Vehicles" ? "active fw-bold border-bottom border-3 border-white" : "")"
                                   asp-area="" asp-controller="Vehicles" asp-action="Index">
                                    <i class="bi bi-truck-front me-2"></i> Vehicles
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center px-3 @(ViewContext.RouteData.Values["controller"]?.ToString() == "User" ? "active fw-bold border-bottom border-3 border-white" : "")"
                                   asp-area="" asp-controller="User" asp-action="Index">
                                    <i class="bi bi-people-fill me-2"></i> Users
                                </a>
                            </li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link d-flex align-items-center px-3 @(ViewContext.RouteData.Values["controller"]?.ToString() == "UserRoles" ? "active fw-bold border-bottom border-3 border-white" : "")"
                                       asp-area="" asp-controller="UserRoles" asp-action="Index">
                                        <i class="bi bi-shield-lock-fill me-2"></i> Roles
                                    </a>
                                </li>
                            }

                        }
                        
                    </ul>
                    <div class="ms-3">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
                
            </div>
        </nav>
    </header>
    <main role="main" class="container flex-grow-1 overflow-auto">
        @RenderBody()
    </main>

    <footer class="bg-dark text-light py-3">
        <div class="container text-center">
            <p>&copy; 2025 CarSaleManage</p>
            <div class="d-flex justify-content-center gap-3">
                <a href="#"><i class="bi bi-facebook text-light"></i></a>
                <a href="#"><i class="bi bi-twitter text-light"></i></a>
                <a href="#"><i class="bi bi-github text-light"></i></a>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
