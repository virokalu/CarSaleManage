@model CarSaleManage.Models.Vehicle

@{
    ViewData["Title"] = "Vehicle Details";
}

<div class="container-fluid mt-4">
    <h2 class="mb-3"><i class="bi bi-info-circle me-2"></i>Vehicle Details</h2>
    <hr />

    <div class="card shadow-sm border-0 mb-5">
        <div class="card-body">
            <!-- Buyer Section -->
            <div class="p-3 mb-4 rounded bg-light border">
                <h5 class="mb-3"><i class="bi bi-person-check me-2"></i>Buyer</h5>
                @if (Model.AppUserId == null)
                {
                    <form asp-action="Buy" method="post" class="d-flex flex-wrap gap-2 align-items-center">
                        <input type="hidden" name="vehicleId" value="@Model.Id" />

                        @Html.DropDownList(
                                          "userId",
                                          ViewBag.UserList as List<SelectListItem>,
                                          "Select a user",
                                          new { @class = "form-select userSelect", required="required" }
                                          )

                        <div class="d-flex gap-2 mt-3 mt-md-0">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-person-plus"></i> Assign to User
                            </button>
                            <button id="generateLinkBtn" class="btn btn-secondary">
                                <i class="bi bi-share"></i> Share
                            </button>
                        </div>
                    </form>

                    <input type="text" id="shareLink" class="form-control mt-2" readonly style="display:none;" />

                }
                else
                {
                    <p class="mb-2">
                        <strong>Sold to:</strong> @Model.AppUser?.Firstname @Model.AppUser?.Lastname (@Model.AppUser?.Email)<br />
                        <strong>Date:</strong> @Model.PurchaseDate?.ToString("yyyy-MM-dd")
                    </p>
                    <div class="d-flex gap-2 mt-3 mt-md-0">
                        @if (User.IsInRole("Admin"))
                        {
                            <form asp-action="RemoveBuy" method="post">
                                <input type="hidden" name="vehicleId" value="@Model.Id" />
                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-x-circle"></i> Remove Assign
                                </button>
                            </form>
                        }
                        <a asp-controller="Vehicles"
                           asp-action="DownloadReceipt"
                           asp-route-userId="@Model.AppUserId"
                           asp-route-vehicleId="@Model.Id"
                           target="_blank"
                           class="btn btn-primary">
                            <i class="bi bi-filetype-pdf"></i> View Receipt
                        </a>
                    </div>
                }
            </div>

            <!-- Vehicle Images -->
            <div class="mb-4">
                <h5><i class="bi bi-images me-2"></i>Images</h5>
                @if (Model.Images != null && Model.Images.Any())
                {
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var img in Model.Images)
                        {
                            <img src="@img" alt="Vehicle Image" class="img-thumbnail" style="max-width: 380px;" />
                        }
                    </div>
                }
                else
                {
                    <span class="text-muted">No images available.</span>
                }
            </div>

            <!-- Vehicle Info -->
            <dl class="row">
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Make)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Make)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ModelNo)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.ModelNo)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Classification)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Classification)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Origin)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Origin)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.UsedCountry)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.UsedCountry)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Year)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Year)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.RegNo)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.RegNo)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.RegDate)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.RegDate)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.EngineNo)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.EngineNo)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FuelSystem)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.FuelSystem)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.EngineCap)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.EngineCap)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ChassisNo)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.ChassisNo)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FuelType)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.FuelType)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Color)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Color)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.MeterReading)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.MeterReading)</dd>
            </dl>

            <!-- Actions -->
            <div class="mt-4 d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left-circle"></i> Back to List
                </a>
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">
                    <i class="bi bi-pencil-square"></i> Edit Vehicle
                </a>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script>
    $(".userSelect").select2();
</script>
<script>
    function isMobile() {
        return /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
    }

    $('#generateLinkBtn').click(function () {
        $.post('@Url.Action("GenerateShareLink", "Vehicles")', { vehicleId: '@Model.Id' }, function (data) {
            const link = data.url;
            $('#shareLink').val(link).show();

            if (isMobile() && navigator.share) {
                navigator.share({
                    title: 'Vehicle Share Link',
                    text: 'View this vehicle:',
                    url: link
                }).catch(function (error) {
                    // fallback: copy to clipboard if share fails
                    navigator.clipboard.writeText(link);
                    alert('Link copied to clipboard!');
                });
            } else if (navigator.clipboard) {
                navigator.clipboard.writeText(link).then(function () {
                    alert('Link copied to clipboard!');
                }, function () {
                    alert('Could not copy link. Please copy it manually.');
                });
            } else {
                // fallback for very old browsers
                $('#shareLink').select();
                document.execCommand('copy');
                alert('Link copied to clipboard!');
            }
        });
    });
</script>